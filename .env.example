# PalmPyaar Environment Variables Example
# Set these in your Vercel Dashboard (Settings -> Environment Variables)

INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
TOKEN_SECRET=
GEMINI_API_KEY=     # optional, only if AI_READING=true

# Optional configuration
# INSTAMOJO_HOST=test.instamojo.com # default in dev: test.instamojo.com, prod: www.instamojo.com
