# PalmPyaar Environment Variables Example
# Set these in your Vercel Dashboard (Settings -> Environment Variables)

# --- Razorpay payment gateway (replaces the old direct-UPI flow) ---
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys.
# Use TEST keys for local testing and LIVE keys only when ready to accept real payments.
RAZORPAY_KEY_ID=              # REQUIRED — PUBLIC key id. Safe to expose to the frontend
                              # (Razorpay Checkout needs it). This is NOT a secret.
RAZORPAY_KEY_SECRET=          # REQUIRED — SECRET. Server-side only. Signs/verifies the
                              # payment signature. NEVER expose to the frontend or logs.
RAZORPAY_WEBHOOK_SECRET=      # REQUIRED for webhooks — SECRET. Server-side only. Must
                              # match the secret you set under Razorpay Dashboard ->
                              # Settings -> Webhooks for the /api/razorpay-webhook URL.
PAYMENT_AMOUNT=49             # OPTIONAL — price in whole rupees (integer). Default 49.

# --- Access control (HMAC reading tokens) ---
TOKEN_SECRET=                 # REQUIRED — long random string. Signs/verifies reading tokens.

# --- Reading providers (optional) ---
# AI_READING=false uses the deterministic template provider (recommended default).
# AI_READING=true switches to an AI provider; requires a valid API key.
AI_READING=false
# GROQ_API_KEY=               # optional, only if AI_READING=true
# GEMINI_API_KEY=             # optional, only if AI_READING=true

# --- Development only (never set these in production) ---
# NODE_ENV=development
# DEV_BYPASS=true             # only with NODE_ENV=development; skips HMAC token
                              # verification in /api/generate-reading for local testing
